# Example Nginx edge policy. Adapt TLS certificate paths and include the
# limit_req_zone directive inside the nginx http {} context.
limit_req_zone $binary_remote_addr zone=fluxqueue_per_ip:10m rate=10r/s;

upstream fluxqueue_api {
    server 127.0.0.1:8000;
    keepalive 32;
}

server {
    listen 443 ssl;
    server_name fluxqueue.example.com;
    server_tokens off;

    # Replace with certificates provisioned by your TLS/certificate manager.
    ssl_certificate /etc/letsencrypt/live/fluxqueue.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fluxqueue.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 128k;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location /api/ {
        limit_req zone=fluxqueue_per_ip burst=20 nodelay;
        limit_req_status 429;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_pass http://fluxqueue_api;
    }

    location /health/ {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://fluxqueue_api;
    }
}
