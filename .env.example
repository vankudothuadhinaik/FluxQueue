# Local smoke-test default. Docker Compose overrides with PostgreSQL.
DATABASE_URL=sqlite:///./fluxqueue.db
APP_ENV=development
LOG_LEVEL=INFO

# Optional future integrations: keep real values in a secret manager.
# CODECOV_TOKEN=
# DOPPLER_TOKEN=

# Optional local single-tenant key. In production, use API_KEYS for tenant isolation.
API_KEY=
API_KEYS={}
MAX_ACTIVE_JOBS_PER_TENANT=1000
# Example production mapping (store real keys only in Doppler or another secret manager):
# API_KEYS={"replace-with-a-long-random-secret":"tenant-a"}
